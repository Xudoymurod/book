   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Happy smiling operator asian woman customer service agent with headsets working on computer in a call center, talking with customer for assisting to resolve the problem with her service mind</rdf:li>
    </rdf:Alt>
